# Copy this file to .env.local and fill in your real values.
# Find Supabase values in: Supabase Dashboard → Project Settings → API

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: SERVER-ONLY, never prefix with NEXT_PUBLIC_. Used exclusively by
# lib/supabase/admin-client.ts inside payment webhook route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Used by sitemap.ts, robots.ts, and metadata generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MTN Mobile Money (Collections API) ---
MTN_MOMO_ENV=sandbox
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=http://localhost:3000/api/webhooks/mtn

# --- Orange Money (Web Payment API) ---
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_RETURN_URL=http://localhost:3000/settings?payment=success
ORANGE_MONEY_CANCEL_URL=http://localhost:3000/pricing?payment=cancelled
ORANGE_MONEY_NOTIF_URL=http://localhost:3000/api/webhooks/orange

# --- CinetPay (card payments via hosted checkout) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=http://localhost:3000/api/webhooks/cinetpay
CINETPAY_RETURN_URL=http://localhost:3000/settings?payment=success
